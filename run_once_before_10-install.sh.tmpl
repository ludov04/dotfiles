#!/bin/bash
# =============================================================================
# Chezmoi pre-install script
# Runs once before applying dotfiles
# =============================================================================
set -e

echo "==> Chezmoi: Running pre-install..."

# -----------------------------------------------------------------------------
# Create XDG directories
# -----------------------------------------------------------------------------
mkdir -p "$HOME/.config"
mkdir -p "$HOME/.local/share"
mkdir -p "$HOME/.local/state/zsh"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.cache/zsh"

export PATH="$HOME/.local/bin:$PATH"

{{- if .isRemote }}
# -----------------------------------------------------------------------------
# Remote/Linux: bootstrap prerequisites for Homebrew (Linuxbrew)
# Everything else is installed through brew, same as macOS.
# -----------------------------------------------------------------------------
if command -v apt-get &>/dev/null; then
    echo "==> Installing Homebrew prerequisites via apt..."
    sudo apt-get update -qq
    # build-essential/procps/curl/file/git are Homebrew's documented Linux deps;
    # zsh is the login shell (set below), locales gives us UTF-8.
    sudo apt-get install -y --no-install-recommends \
        build-essential \
        procps \
        curl \
        file \
        git \
        zsh \
        locales \
        || true

    # Generate UTF-8 locale (needed for unicode in prompt/tools)
    if command -v locale-gen &>/dev/null; then
        sudo sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || true
        sudo locale-gen en_US.UTF-8 2>/dev/null || true
    fi
fi
{{- end }}

# -----------------------------------------------------------------------------
# Install Homebrew (macOS + remote Linux) and load it into this shell
# -----------------------------------------------------------------------------
# Homebrew clones its repo + taps over HTTPS. If a global git `insteadOf`
# rewrites https://github.com/ -> SSH (e.g. Coder workspaces), brew's internal
# git can't use that SSH path and `brew update`/tap clones fail. Git uses the
# LONGEST matching insteadOf, so identity mappings for the public orgs brew
# pulls from keep those on HTTPS without touching the global SSH-everywhere
# policy. Idempotent. Add a line here when adding a tap from a new org.
if command -v git &>/dev/null; then
    for org in Homebrew hashicorp; do
        git config --global "url.https://github.com/${org}/.insteadOf" \
            "https://github.com/${org}/"
    done
fi

if ! command -v brew &>/dev/null; then
    echo "==> Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Load brew into PATH from whichever prefix it landed in
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew \
                /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [[ -x "$brew_bin" ]]; then
        eval "$("$brew_bin" shellenv)"
        break
    fi
done

# Third-party taps must be trusted before brew will load their formulae.
# Tap + trust up front so `brew bundle` runs non-interactively.
if command -v brew &>/dev/null; then
    brew tap hashicorp/tap 2>/dev/null || true
    brew trust hashicorp/tap 2>/dev/null || true
fi

# Install shared CLI tools from the Brewfile
if command -v brew &>/dev/null && [[ -f "{{ .chezmoi.sourceDir }}/Brewfile" ]]; then
    echo "==> Installing Homebrew packages (Brewfile)..."
    brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile" || {
        echo "==> Some packages failed to install (continuing anyway)"
    }
fi

{{- if .hasGui }}
# macOS-only GUI apps, casks and fonts
if command -v brew &>/dev/null && [[ -f "{{ .chezmoi.sourceDir }}/Brewfile.macos" ]]; then
    echo "==> Installing macOS Homebrew apps (Brewfile.macos)..."
    brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.macos" || {
        echo "==> Some apps failed to install (continuing anyway)"
    }
fi
{{- end }}

{{- if .isRemote }}
# -----------------------------------------------------------------------------
# Remote/Linux: make zsh the default shell
# -----------------------------------------------------------------------------
if command -v zsh &>/dev/null && [[ "$SHELL" != *"zsh"* ]]; then
    echo "==> Setting zsh as default shell..."
    sudo chsh -s "$(command -v zsh)" "$(whoami)" 2>/dev/null || true
fi
{{- end }}

# -----------------------------------------------------------------------------
# Install tmux plugin manager
# -----------------------------------------------------------------------------
if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    echo "==> Installing tmux plugin manager..."
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

echo "==> Pre-install complete!"
