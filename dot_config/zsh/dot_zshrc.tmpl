# =============================================================================
# ZSH Configuration (managed by chezmoi)
# =============================================================================

# -----------------------------------------------------------------------------
# Locale (ensure UTF-8 for proper unicode rendering)
# -----------------------------------------------------------------------------
export LANG="${LANG:-en_US.UTF-8}"

# -----------------------------------------------------------------------------
# PATH additions
# -----------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

{{- if .hasHomebrew }}
# -----------------------------------------------------------------------------
# Homebrew (must be first for PATH) - macOS /opt, Linuxbrew /home/linuxbrew
# -----------------------------------------------------------------------------
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew \
                /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [[ -x "$brew_bin" ]]; then
        eval "$("$brew_bin" shellenv)"
        break
    fi
done
{{- end }}

{{- if .hasMise }}
# -----------------------------------------------------------------------------
# mise (version manager for node, go, python, etc.)
# -----------------------------------------------------------------------------
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi
{{- end }}

# -----------------------------------------------------------------------------
# Prompt (Starship)
# -----------------------------------------------------------------------------
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# -----------------------------------------------------------------------------
# Source modular configs (order matters!)
# -----------------------------------------------------------------------------
# 1. Completions first (sets up history, completion system, fzf, key bindings)
[[ -f "$ZDOTDIR/completions.zsh" ]] && source "$ZDOTDIR/completions.zsh"

# 2. Modern CLI tools (zoxide, eza, bat, atuin, direnv)
[[ -f "$ZDOTDIR/tools.zsh" ]] && source "$ZDOTDIR/tools.zsh"

# 3. Aliases
[[ -f "$ZDOTDIR/aliases.zsh" ]] && source "$ZDOTDIR/aliases.zsh"

# 4. Functions
[[ -f "$ZDOTDIR/functions.zsh" ]] && source "$ZDOTDIR/functions.zsh"

{{- if .hasHomebrew }}
# -----------------------------------------------------------------------------
# Zsh plugins (via Homebrew) - AFTER completions.zsh sets strategies
# HOMEBREW_PREFIX is set by `brew shellenv` above (works on macOS + Linuxbrew)
# -----------------------------------------------------------------------------
# Autosuggestions (shows inline suggestions from history)
if [[ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# Fast syntax highlighting (better than zsh-syntax-highlighting - must be last!)
if [[ -f "$HOMEBREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" ]]; then
    source "$HOMEBREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
fi
{{- end }}

{{- if .has1Password }}
# -----------------------------------------------------------------------------
# 1Password SSH agent (for agent forwarding to work)
# -----------------------------------------------------------------------------
if [[ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]]; then
    export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# -----------------------------------------------------------------------------
# 1Password CLI plugin (if exists)
# -----------------------------------------------------------------------------
if [[ -f "$HOME/.config/op/plugins.sh" ]]; then
    source "$HOME/.config/op/plugins.sh"
fi
{{- end }}

# pnpm
export PNPM_HOME="{{ .chezmoi.homeDir }}/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# -----------------------------------------------------------------------------
# Coder workspace: neutralize the stale agent token
# -----------------------------------------------------------------------------
# On the EC2 (Superset) template, /etc/superset/coder-env is re-sourced into every
# login shell via /etc/zsh/zprofile and re-exports a CODER_AGENT_TOKEN captured at
# boot. The agent actually authenticates via aws-instance-identity, so the server
# rotates that token and the frozen copy goes stale, making `coder gitssh` fail with
# "Workspace agent not authorized" (breaks git over SSH). This runs after zprofile,
# so drop the stale token and pin the agent's real auth mode. Guarded to Coder boxes;
# harmless no-op once the template publishes CODER_AGENT_AUTH instead of the token.
if [[ -n "$CODER_AGENT_URL" ]]; then
  unset CODER_AGENT_TOKEN
  export CODER_AGENT_AUTH=aws-instance-identity
fi
